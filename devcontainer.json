{
    "name": "C-CPP-Project",
    "build": {
        "dockerfile": "dockerfile",
        "args": {
            "UID": "${localEnv:UID:1000}",
            "GID": "${localEnv:GID:1000}",
            "NAME": "${localEnv:USER:mabasset}"
        }
    },
    "workspaceFolder": "${localEnv:HOME}",
    "remoteUser": "${localEnv:USER:mabasset}",
    "mounts": [
        "source=../,target=${localEnv:HOME}/workspace,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools"
            ]
        }
    }
}